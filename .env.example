# BygSmart 3.0 Native — environment reference (copy to .env / .env.hosted; never commit real values).
#
# DEV (default): runs on LOCAL Supabase — `npx supabase start`, then export the keys from
#   `npx supabase status -o env`. No .env needed for the local flow (see docs/mobile-fork/P5A_LIVE_BACKEND.md).
#
# HOSTED: the paid Supabase account (org tiiletfqqbwrxekbgfiz) + Stripe TEST config are saved in the
#   gitignored `.env.hosted` (retrieved from the 2.1 project). NOTE: the existing 'byggeapp' DB has the
#   2.1 SCHEMA — going hosted means creating a NEW 3.0 project in that org (SUPABASE_ACCESS_TOKEN),
#   applying supabase/migrations there, then filling the values below with that project's URL/keys.

# ── App (Metro / web build; EXPO_PUBLIC_* are inlined at build time) ──
EXPO_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co  (or http://127.0.0.1:54321 local)
EXPO_PUBLIC_SUPABASE_ANON_KEY=       # the project anon key
EXPO_PUBLIC_SYNC_URL=                # the Express sync API origin incl. /api (e.g. http://127.0.0.1:3100/api)

# ── Server (@bygsmart/server) ──
SUPABASE_URL=                        # project URL (same host as above, no /api)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=                 # HS256 secret (legacy/dev tokens); modern ES256 tokens verify via JWKS
# SUPABASE_JWKS_URL=                 # optional override; defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
PORT=3100
# CORS_ORIGIN=*                      # tighten to the app origin in production

# ── Provisioning (reuse the existing paid account) ──
SUPABASE_ACCESS_TOKEN=               # create/manage the 3.0 project via the CLI/MCP
SUPABASE_ORG_ID=tiiletfqqbwrxekbgfiz

# ── Stripe (TEST; for the future 3.0 billing flow — not wired yet) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# ── Push / AI (used later) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GEMINI_API_KEY=
