{
  "expo": {
    "name": "BygSmart",
    "slug": "bygsmart",
    "scheme": "bygsmart",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.bygsmart.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bygsmart.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
