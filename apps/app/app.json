{
  "expo": {
    "name": "BygSmart",
    "slug": "byggeapp-native",
    "scheme": "bygsmart",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.bygsmart.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bygsmart.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce8fcd14-2ce4-4956-8c21-c8c34175cb21"
      }
    },
    "owner": "waypays-team"
  }
}
