# ============================================================
# BYGGESMART 2.0 - Environment Variables (EXAMPLE)
# ============================================================
# SECURITY: This is the ONLY env file that may be committed.
# It must contain placeholders only — NEVER real secrets.
#
# Real secrets (API keys, tokens, passwords, DB URLs) belong ONLY in:
#   - untracked local env files (.env, .env.production, .env.local — all
#     git-ignored), or
#   - a dedicated secret manager / the host's environment variables.
#
# At runtime, docker-compose.yml injects secrets from host environment
# variables — they are never read from a committed file.
#
# Copy this file to .env and fill in your actual values.
# Never commit a real .env file to version control.

# --- Frontend (Vite) ---
# The two REQUIRED variables below must be set before starting the dev server.
# Without them the app will show a blank loading screen.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co   # REQUIRED
VITE_SUPABASE_ANON_KEY=your-anon-key-here                # REQUIRED
VITE_APP_NAME=BygSmart
VITE_SENTRY_DSN=
VITE_PUBLIC_BASE_PATH=/
# Cloudflare Turnstile CAPTCHA public SITE key (safe to expose to the browser).
# Protects signup/login from bots (F-05). Leave empty to disable the widget in
# local dev. Get a free key at https://dash.cloudflare.com → Turnstile.
# The matching SECRET key is configured server-side as SUPABASE_AUTH_CAPTCHA_SECRET.
VITE_TURNSTILE_SITE_KEY=
# --- OAuth Clients (optional) ---
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_DROPBOX_CLIENT_ID=your-dropbox-client-id
VITE_ONEDRIVE_CLIENT_ID=your-onedrive-client-id
VITE_BOX_CLIENT_ID=your-box-client-id

# --- API Service (server/index.js) ---
ALLOWED_ORIGIN=https://app.bygsmart.com,https://bygsmart.com
GEMINI_API_KEY=your-gemini-api-key-here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase Auth / Edge functions ---
# Cloudflare Turnstile CAPTCHA SECRET key (server-side only — NEVER expose to the
# browser). Referenced by supabase/config.toml ([auth.captcha]). Pairs with the
# public VITE_TURNSTILE_SITE_KEY above.
SUPABASE_AUTH_CAPTCHA_SECRET=your-turnstile-secret-key
# Comma-separated CORS allow-list for the ai-gateway edge function. Defaults to
# https://app.bygsmart.com when unset.
AI_GATEWAY_ALLOWED_ORIGINS=https://app.bygsmart.com

# --- AI Orchestration (server/aiProviders.js + server/aiRoutes.js) ---
# Secret used to encrypt provider API keys (AES-256-GCM, key derived via
# scrypt) before they are stored in the ai_provider_configs table.
# Generate with: openssl rand -base64 32
# Rotating this secret invalidates all stored provider keys (re-enter them
# in the admin AI panel afterwards).
AI_KEYS_SECRET=generate-a-long-random-secret-here

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly
STRIPE_PRICE_PREMIUM_MONTHLY=price_premium_monthly
STRIPE_PRICE_PREMIUM_YEARLY=price_premium_yearly

# --- Demo/PWA Push ---
DEMO_LOGIN_EMAIL_DOMAIN=demo.bygsmart.dk
# Optional: fallback demo credentials for local dev when backend server is not running
# Create a demo account in Supabase manually and put the credentials here
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@bygsmart.dk

# --- Email / SMTP ---
# Global SMTP settings are configured in-app via the Admin Dashboard
# (Admin → E-mail / SMTP tab) and stored encrypted in the smtp_configs table.
# The same AI_KEYS_SECRET above is used to encrypt the SMTP password at rest.
# Premium/Enterprise subscription owners can override with their own SMTP
# server via Settings → E-mail (SMTP).
# No additional environment variables are required for SMTP.
